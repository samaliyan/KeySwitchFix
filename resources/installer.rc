#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"
IDR_APP_BINARY RCDATA "../dist/KeySwitchFix.exe"
IDR_UNINSTALL_BINARY RCDATA "../dist/KeySwitchFix-Uninstall.exe"

IDD_INSTALLER DIALOGEX 0, 0, 372, 204
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KeySwitchFix Setup"
FONT 9, "Segoe UI"
BEGIN
    ICON        IDI_APP, IDC_INSTALL_ICON, 18, 18, 44, 44
    LTEXT       "Install KeySwitchFix", IDC_INSTALL_TITLE, 78, 20, 260, 18
    LTEXT       "Automatic Persian / English keyboard layout repair", IDC_INSTALL_TEXT, 78, 43, 270, 26
    CONTROL     "Start KeySwitchFix with Windows", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 78, 88, 230, 16
    LTEXT       "Installs for the current Windows user. Administrator access is not required.", IDC_INSTALL_NOTE, 78, 116, 260, 26
    DEFPUSHBUTTON "Install", IDC_INSTALL, 204, 166, 72, 24
    PUSHBUTTON  "Cancel", IDC_CANCEL, 284, 166, 72, 24
END

1 VERSIONINFO
FILEVERSION 2,1,1,0
PRODUCTVERSION 2,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "KeySwitchFix"
      VALUE "FileDescription", "KeySwitchFix Setup and Uninstaller"
      VALUE "FileVersion", "2.1.1"
      VALUE "InternalName", "KeySwitchFixSetup"
      VALUE "LegalCopyright", "Copyright (c) 2026"
      VALUE "OriginalFilename", "KeySwitchFix-Setup.exe"
      VALUE "ProductName", "KeySwitchFix"
      VALUE "ProductVersion", "2.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
